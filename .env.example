# =============================================================================
# Candle Gift Box Production Builder — environment vars (overview)
# =============================================================================
# This file documents every env var the app uses. The app actually reads from
# `frontend/.env` (Vite) and `backend/.env` (dotenv) — copy the relevant
# section into the matching `.env` for local dev.
#
# In monday-code production, set vars via:
#     mapps code:env -m set -k KEY_NAME -v VALUE
#
# `.env` files are gitignored. NEVER commit real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# backend/.env  →  Express fragrance API on :8080
# -----------------------------------------------------------------------------

# Local dev port for the Express server.
PORT=8080

# Personal monday API token used by `@mondaycom/apps-sdk` Storage.
# Get it from: monday.com → Profile → Developers → My access tokens.
# OPTIONAL for local dev — if unset, the backend falls back to an in-memory
# store so you can run end-to-end without a token. monday-code injects this
# automatically in production.
MONDAY_TOKEN=


# -----------------------------------------------------------------------------
# frontend/.env  →  Vite dev server on :8301
# -----------------------------------------------------------------------------

# Vite dev port (the mapps tunnel forwards to this).
# PORT=8301
# BROWSER=none

# Where the fragrance backend is reachable from the frontend.
#  - Local dev:  "/api"  (vite.config.js proxies /api/* → http://localhost:8080
#                so the frontend talks to the backend over the same HTTPS
#                origin as the tunnel — no CORS, no mixed-content blocks).
#  - Production: your deployed monday-code backend URL,
#                e.g. https://abc123.monday-code.com
VITE_FRAGRANCE_API_URL=/api

# Dev-only fallbacks. When the app is opened OUTSIDE monday's iframe (e.g. you
# hit the tunnel URL directly in a browser to iterate), there's no `context`
# event so we don't get a boardId or session token. These let the Kanban load
# anyway. Both are ignored when the app is opened from inside monday.
#
# WARNING: VITE_DEV_API_TOKEN is bundled into the client. Use a personal,
# revocable token only — never a customer token. Remove before sharing builds.
VITE_DEV_BOARD_ID=
VITE_DEV_API_TOKEN=
